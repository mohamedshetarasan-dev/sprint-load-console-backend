# Azure DevOps connection (required)
AZURE_DEVOPS_ORG_URL=https://tameeni.visualstudio.com
AZURE_DEVOPS_PAT=paste_your_personal_access_token_here

# Optional — the dashboard has a Scope picker (Project / Team / Area Path
# dropdowns) for choosing these at runtime. These just pre-select the dropdowns
# on first load and act as a fallback if /api/sprint-data is called without them.
DEFAULT_PROJECT=TameeniPortal
DEFAULT_TEAM=Motor ShortTerm Team
DEFAULT_AREA_PATH=TameeniPortal\Motor ShortTerm Team

# Optional: comma-separated sprint names to expose.
# If left blank, the server auto-discovers the selected team's iterations.
SPRINT_ALLOWLIST=

# How long (seconds) to cache Azure DevOps results before re-fetching
CACHE_TTL_SECONDS=900

# Port for the local server
PORT=8787
